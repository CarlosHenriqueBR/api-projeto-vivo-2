    {
      "name": "2. Consulta",
      "item": [
        {
          "name": "Consultar dividas (token atual)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/consulta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "consulta"
              ]
            },
            "description": "Retorna a massa do documento dono do token, no formato statusCode / body / headers."
          }
        },
        {
          "name": "Consultar dividas por documento",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/consulta/{{documento}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "consulta",
                "{{documento}}"
              ]
            },
            "description": "Mesma consulta, mas conferindo o documento na rota. Se o token for de outro documento a API responde 403."
          }
        }
      ]
    },
