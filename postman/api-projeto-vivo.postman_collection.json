  "item": [
    {
      "name": "1. Autenticacao",
      "item": [
        {
          "name": "Token com CPF",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const dados = pm.response.json();",
                  "pm.test(\"token retornado\", () => pm.expect(dados.access_token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"token\", dados.access_token);",
                  "pm.collectionVariables.set(\"documento\", dados.documento);",
                  "console.log(\"Token salvo para\", dados.documentoFormatado, \"-\", dados.nome);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"documento\": \"432.520.270-62\",\n  \"senha\": \"Vivo@7062\"\n}"
            },
            "description": "Autentica com CPF 432.520.270-62 (Aurelio Prado Bittencourt). O token e salvo automaticamente na variavel {{token}} pelo script da aba Tests."
          }
        },
