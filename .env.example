# Porta e host da API.
# Em producao (Render) a PORT e injetada pela plataforma e o HOST precisa ser 0.0.0.0.
PORT=3333
HOST=0.0.0.0

# Segredo usado para assinar o JWT HS256. OBRIGATORIO em producao.
API_SECRET=segredo-local-projeto-vivo

# Validade do token, em segundos
TOKEN_TTL=3600

# true = senha obrigatoria no POST /api/v1/auth/token
EXIGIR_SENHA=false

# true = expoe GET /api/v1/massas com a lista de documentos e senhas de teste
EXPOR_MASSAS=true

# Caminho alternativo para o arquivo de massas
# ARQUIVO_MASSAS=./data/massas.json
